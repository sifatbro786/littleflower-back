# Copy to .env and fill in. Never commit .env.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# PostgreSQL (local): user greendale owns database greendale
DATABASE_URL=postgresql://greendale:CHANGE_ME@localhost:5432/greendale?schema=public
DB_POOL_MAX=10

# Redis Cloud free (dev) — eviction policy must be noeviction. Use rediss:// if TLS is enabled.
REDIS_URL=redis://default:CHANGE_ME@redis-12345.c1.ap-south-1-1.ec2.redns.redis-cloud.com:12345
QUEUE_PREFIX=greendale

# Two different random values, 64 bytes each
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

APP_URL=http://localhost:3000
# The worker calls <WEB_INTERNAL_URL>/internal/revalidate after website (CMS) saves.
WEB_INTERNAL_URL=http://127.0.0.1:3000
# Same value in greendale-front .env (16+ chars). Empty = the website only updates when its cache expires.
REVALIDATE_SECRET=
# Local disk for uploads (VPS: /var/www/greendale/uploads, outside the code folder)
UPLOAD_DIR=./uploads
BEHIND_CLOUDFLARE=false

# Email (Nodemailer over SMTP, always sent by the worker). Port 465 = TLS, 587 = STARTTLS.
# Empty SMTP_HOST: emails are logged as FAILED in EmailLog and contact messages are still saved.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=strsolutionsltd@gmail.com
SMTP_PASS=
MAIL_FROM="Greendale School <strsolutionsltd@gmail.com>"
CONTACT_TO=strsolutionsltd@gmail.com

# Step 3+ (leave empty for now)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SSLC_STORE_ID=
SSLC_STORE_PASS=
SSLC_SANDBOX=true

# Seed: Super Admin is created once if missing (password is never updated by the seed)
SUPERADMIN_EMAIL=solaimanislamsifat@gmail.com
SUPERADMIN_PASSWORD=
# Demo data (development only; blocked when NODE_ENV=production)
SEED_DEMO=false
SEED_DEMO_PASSWORD=
